PORT=8787
MCP_SERVER_NAME=code-sherpa
MCP_SERVER_VERSION=0.1.0

SSH_HOST=192.0.2.17
SSH_PORT=22
SSH_USERNAME=readonly_user
SSH_PRIVATE_KEY_PATH=/run/secrets/id_ed25519
SSH_KNOWN_HOSTS_PATH=/run/secrets/known_hosts
SSH_READY_TIMEOUT_MS=10000
SSH_EXEC_TIMEOUT_MS=15000

REPO_ROOT=/srv/repos/project-repo

MAX_FILE_BYTES=100000
MAX_SEARCH_RESULTS=100
MAX_LOG_COMMITS=30
MAX_RESPONSE_CHARS=200000
DENY_PATH_SEGMENTS=.git,node_modules,dist,build,.next,.turbo,.cache,.env,.env.local,.env.production,.ssh

MCP_BEARER_TOKEN=replace-with-long-random-bearer-token

OAUTH_ISSUER_BASE_URL=https://code-sherpa.example.com
OAUTH_LOGIN_USERNAME=replace-me
OAUTH_LOGIN_PASSWORD=replace-me
OAUTH_SESSION_SECRET=replace-with-long-random-secret
OAUTH_COOKIE_SECURE=true

CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
